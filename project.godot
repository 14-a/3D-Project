; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[addons]

csg_blockout/material_preset=1
csg_blockout/custom_material_path="res://Texture/PNG/Light/顺时针旋转.tres"
csg_blockout/language_override="zh_CN"
csg_blockout/bake/lod=true
csg_blockout/room/open_top=false
csg_blockout/room/height=5.0
csg_blockout/openings/door_size=Vector2(1.5, 2.5)

[application]

config/name="New Project Demo"
run/main_scene="uid://5iqqcvkmyamp"
config/features=PackedStringArray("4.8", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

CyclopsAutoload="*uid://4siqre3jhe80"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/csg_blockout/plugin.cfg", "res://addons/gator_audio_studio/plugin.cfg", "res://addons/gator_model_studio/plugin.cfg", "res://addons/gator_sprite_studio/plugin.cfg")

