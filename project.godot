window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/cyclops_level_builder/plugin.cfg", "res://addons/gator_audio_studio/plugin.cfg", "res://addons/gator_model_studio/plugin.cfg", "res://addons/gator_sprite_studio/plugin.cfg", "res://addons/godot_ai/plugin.cfg")

